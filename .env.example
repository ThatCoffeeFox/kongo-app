# Kongo auto-selects qwen3.5:9b for this RTX 3070 8GB + 16GB RAM PC.
KONGO_MODEL_URL=http://127.0.0.1:11434/v1
KONGO_MODEL=qwen3.5:9b
# KONGO_MODEL_KEY=only needed for remote OpenAI-compatible providers
KONGO_PORT=3210

# Optional accounts and cloud persistence
DATABASE_URL=postgres://kongo:kongo-local-dev@127.0.0.1:54329/kongo
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
BETTER_AUTH_URL=http://127.0.0.1:3210
